PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/attendance_payroll

# JWT
JWT_SECRET=change_this_to_a_random_32_char_string
JWT_EXPIRES_IN=7d

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Office Hours (24hr format)
OFFICE_START_TIME=09:00
OFFICE_END_TIME=18:00
LATE_THRESHOLD_MINUTES=15

# Payroll Deduction Rates
PF_RATE=0.12
ESIC_RATE=0.0075
PT_MONTHLY=200
TDS_RATE=0.10